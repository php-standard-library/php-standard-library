{
    "name": "php-standard-library/compression",
    "description": "Streaming compression and decompression abstractions for IO handles",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "compression",
        "decompression",
        "streaming",
        "io"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/io": "^6.1"
    },
    "require-dev": {
        "ext-brotli": "*",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Compression\\": "src/Psl/Compression/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Compression\\Tests\\Fixture\\": "tests/fixture/",
            "Psl\\Compression\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

{
    "name": "php-standard-library/crypto",
    "description": "Comprehensive cryptography toolkit built on libsodium - symmetric, asymmetric, AEAD, signing, key exchange, and KDF",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "crypto",
        "encryption",
        "libsodium",
        "signing"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-sodium": "*",
        "php-standard-library/encoding": "^6.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/hash": "^6.0",
        "php-standard-library/io": "^6.0",
        "php-standard-library/secure-random": "^6.0"
    },
    "require-dev": {
        "php-standard-library/async": "^6.0",
        "php-standard-library/math": "^6.0",
        "php-standard-library/str": "^6.0",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Crypto\\": "src/Psl/Crypto/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Crypto\\Tests\\Fixture\\": "tests/fixture/",
            "Psl\\Crypto\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

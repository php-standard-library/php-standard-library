{
    "name": "php-standard-library/data-structure",
    "description": "Classic data structures: Queue (FIFO), Stack (LIFO), and PriorityQueue",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "data-structure",
        "queue",
        "stack",
        "priority-queue"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/default": "^6.0",
        "php-standard-library/foundation": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\DataStructure\\": "src/Psl/DataStructure/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\DataStructure\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

{
    "name": "php-standard-library/dnssec",
    "description": "DNSSEC validation with full trust chain verification, RRSIG signatures, and NSEC/NSEC3 proofs",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "dnssec",
        "dns",
        "security",
        "validation"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/cache": "^6.0",
        "php-standard-library/crypto": "^6.0",
        "php-standard-library/date-time": "^6.0",
        "php-standard-library/dns": "^6.2",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/hash": "^6.0"
    },
    "require-dev": {
        "php-standard-library/binary": "^6.0",
        "php-standard-library/encoding": "^6.2",
        "php-standard-library/ip": "^6.0",
        "php-standard-library/iter": "^6.0",
        "php-standard-library/str": "^6.0",
        "php-standard-library/vec": "^6.0",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\DNSSEC\\": "src/Psl/DNSSEC/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\DNSSEC\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

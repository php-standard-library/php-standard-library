{
    "name": "php-standard-library/fun",
    "description": "Functional programming utilities for composing, decorating, and controlling function execution",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "functional",
        "composition",
        "pipe"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/hash": "^6.0",
        "php-standard-library/str": "^6.0",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Fun\\": "src/Psl/Fun/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Fun\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

{
    "name": "php-standard-library/http-message",
    "description": "HTTP message abstractions for requests, responses, and headers",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "http",
        "message",
        "request",
        "response"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/default": "^6.0",
        "php-standard-library/io": "^6.0",
        "php-standard-library/url": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\HTTP\\Message\\": "src/Psl/HTTP/Message/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\HTTP\\Message\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

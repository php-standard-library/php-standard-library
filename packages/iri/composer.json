{
    "name": "php-standard-library/iri",
    "description": "RFC 3987 compliant Internationalized Resource Identifier (IRI) parsing, construction, and manipulation",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "iri",
        "rfc3987",
        "internationalized",
        "parsing"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/ip": "^6.0",
        "php-standard-library/punycode": "^6.0",
        "php-standard-library/uri": "^6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\IRI\\": "src/Psl/IRI/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\IRI\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

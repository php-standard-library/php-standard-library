{
    "name": "php-standard-library/message",
    "description": "RFC 5322 internet message construction and parsing",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "message",
        "email",
        "rfc5322",
        "mime"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/date-time": "^6.0",
        "php-standard-library/encoding": "^6.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/io": "^6.2",
        "php-standard-library/mime": "^6.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Message\\": "src/Psl/Message/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Message\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

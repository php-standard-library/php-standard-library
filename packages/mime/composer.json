{
    "name": "php-standard-library/mime",
    "description": "MIME media types, multipart body construction, content sniffing, S/MIME cryptography, and DKIM signing",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "mime",
        "mime-type",
        "content-type"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/date-time": "^6.0",
        "php-standard-library/default": "^6.0",
        "php-standard-library/encoding": "^6.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/io": "^6.0"
    },
    "require-dev": {
        "php-standard-library/iter": "^6.0",
        "php-standard-library/str": "^6.0",
        "php-standard-library/vec": "^6.0",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\MIME\\": "src/Psl/MIME/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\MIME\\Tests\\Fixture\\": "tests/fixture/",
            "Psl\\MIME\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

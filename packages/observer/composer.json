{
    "name": "php-standard-library/observer",
    "description": "Generic Observer pattern interfaces",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "observer",
        "design-pattern"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Observer\\": "src/Psl/Observer/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Observer\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

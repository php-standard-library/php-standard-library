{
    "name": "php-standard-library/password",
    "description": "Secure password hashing and verification with bcrypt and Argon2",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "password",
        "bcrypt",
        "argon2",
        "hashing"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "ext-sodium": "*",
        "php-standard-library/default": "^6.0"
    },
    "require-dev": {
        "php-standard-library/secure-random": "^6.0",
        "php-standard-library/str": "^6.0",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Password\\": "src/Psl/Password/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Password\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

{
    "name": "php-standard-library/socks",
    "description": "SOCKS5 proxy connector for tunneling TCP connections (RFC 1928)",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "socks",
        "socks5",
        "proxy"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/foundation": "^6.0",
        "php-standard-library/io": "^6.0",
        "php-standard-library/network": "^6.0",
        "php-standard-library/tcp": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\Socks\\": "src/Psl/Socks/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\Socks\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}

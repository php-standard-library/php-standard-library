{
    "name": "php-standard-library/udp",
    "description": "Non-blocking API for sending and receiving datagrams over UDP",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "udp",
        "datagram",
        "networking",
        "async"
    ],
    "authors": [
        {
            "name": "Seifeddine Gmati",
            "email": "azjezz@carthage.software"
        },
        {
            "name": "Contributors",
            "homepage": "https://github.com/php-standard-library/php-standard-library/graphs/contributors"
        }
    ],
    "homepage": "https://php-standard-library.dev",
    "require": {
        "php": "~8.4.0 || ~8.5.0",
        "php-standard-library/async": "^6.0",
        "php-standard-library/default": "^6.0",
        "php-standard-library/io": "^6.0",
        "php-standard-library/network": "^6.0",
        "revolt/event-loop": "^1.0.8"
    },
    "require-dev": {
        "php-standard-library/date-time": "^6.0",
        "php-standard-library/os": "^6.0",
        "phpunit/phpunit": "^13.0"
    },
    "conflict": {
        "azjezz/psl": "*"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Psl\\UDP\\": "src/Psl/UDP/"
        },
        "files": [
            "src/Psl/bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Psl\\UDP\\Tests\\Unit\\": "tests/unit/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-next": "6.3.x-dev"
        }
    }
}
